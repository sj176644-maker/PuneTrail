rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own trip document.
    match /users/{uid}/trips/{tripId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['stops', 'updatedAt'])
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 50
        && request.resource.data.stops.toSet().size() == request.resource.data.stops.size()
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
